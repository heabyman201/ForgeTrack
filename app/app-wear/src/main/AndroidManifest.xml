<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>


    <!-- Tell Play that we use HR hardware -->
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:name="com.forgecompose.app_wear.presentation.WearApplication"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />

        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="com.forgecompose.app_wear.presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.forgecompose.app_wear.presentation.WearWorkoutActivity"
            android:taskAffinity="" />
        <!-- AndroidManifest.xml (Wear) -->
        <service
            android:name="com.forgecompose.app_wear.presentation.PassiveDataReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.health.services.client.action.PASSIVE_DATA" />
            </intent-filter>
        </service>
        <service
            android:name="com.forgecompose.app_wear.presentation.WearHrControlListenerService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/hr_control"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/hr_control_state"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/workout_config"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <service
            android:name="com.forgecompose.app_wear.presentation.HrMonitorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="health" />
        <meta-data
            android:name="com.google.android.wearable.beta.app"
            android:resource="@xml/ass" />



    </application>

</manifest>
